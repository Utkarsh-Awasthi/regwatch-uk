# Copy to .env and export (e.g. `set -a; source .env; set +a`). All optional.
REGWATCH_DB=data/regwatch.db
REGWATCH_BASE_URL=http://localhost:8000
REGWATCH_SECRET=change-me-to-a-long-random-string
# Claude summaries (falls back to extractive summaries when unset)
ANTHROPIC_API_KEY=
REGWATCH_LLM_MODEL=claude-opus-5-5
REGWATCH_MIN_FAITHFULNESS=0.9
# Email delivery (writes to data/outbox/ when unset)
REGWATCH_SMTP_HOST=
REGWATCH_SMTP_PORT=587
REGWATCH_SMTP_USER=
REGWATCH_SMTP_PASSWORD=
REGWATCH_MAIL_FROM=digest@your-domain.example
